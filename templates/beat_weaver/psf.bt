        Audio

    Section 2:
        Artist
        Title
        Description

    Section 3:
        Header
        Instrument
        Tempo
        Chord
        Speed_Factor
        Time_Signature
        Intensity
        Section
        Solo
        Loop
        Destination
        Fork
        Routes
        Marked
        Secret
        Keys
        Stream
        
    Section 4:
        Easy
        Medium
        Hard
        Expert

    Section 5:
        FMOD_Bank_AES
    */
    
    PvblSection song(FileSize());
    //PvblSection artist;
    
    // Version, Artist, Header, Easy, FMOD_Bank_AES
} PsfFile;

PsfFile file;